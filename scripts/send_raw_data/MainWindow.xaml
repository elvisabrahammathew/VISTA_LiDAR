<Window x:Class="RawDataSender.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VISTA Raw Data Sender" Width="940" Height="620" MinWidth="800" MinHeight="540"
 Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="24" Background="#F3F6FA">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <TextBlock Text="Raw Data Sender" FontSize="27" FontWeight="SemiBold" Foreground="#163A5F" Margin="0,0,0,16"/>
  <Border Grid.Row="1" Background="White" Padding="16" CornerRadius="8" BorderBrush="#DFE6EE" BorderThickness="1">
   <StackPanel>
    <TextBlock Text="Input file" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="FileBox"/>
     <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="Browse_Click" Margin="10,0,0,0"/>
    </Grid>
    <Grid Margin="0,14,0,0" x:Name="SettingsGrid">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Output COM port" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock Grid.Column="2" Text="Baud rate (8N1)" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock Grid.Column="4" Text="Send rate" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <ComboBox Grid.Row="1" x:Name="PortCombo"/>
     <ComboBox Grid.Row="1" Grid.Column="2" x:Name="BaudCombo" IsEditable="True">
      <ComboBoxItem Content="115200"/><ComboBoxItem Content="921600"/><ComboBoxItem Content="2000000"/><ComboBoxItem Content="4000000"/>
     </ComboBox>
     <ComboBox Grid.Row="1" Grid.Column="4" x:Name="SpeedCombo" SelectedIndex="2">
      <ComboBoxItem Content="0.25x" Tag="0.25"/><ComboBoxItem Content="0.5x" Tag="0.5"/>
      <ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="2x" Tag="2"/><ComboBoxItem Content="4x" Tag="4"/>
     </ComboBox>
     <Button Grid.Row="2" x:Name="RefreshButton" Content="Refresh ports" Click="Refresh_Click" Margin="0,8,0,0" Padding="8,4" MinHeight="30"/>
     <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" x:Name="LoopCheck" Content="Loop until stopped" Margin="0,14,0,0"/>
    </Grid>
   </StackPanel>
  </Border>
  <DockPanel Grid.Row="2" Margin="0,16,0,12" LastChildFill="True">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
    <Button x:Name="StartButton" Content="Start sending" Click="Start_Click" Background="#1764A5" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/>
    <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" Foreground="#163A5F" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
  </DockPanel>
  <StackPanel Grid.Row="3" Margin="0,0,0,12">
   <ProgressBar x:Name="FileProgress" Minimum="0" Maximum="100" Height="10"/>
   <TextBlock x:Name="ProgressText" Text="No data sent." Margin="0,8,0,0" Foreground="#344B61" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" Background="#102437" Foreground="#E6EFF8"
   FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" MinHeight="90"/>
 </Grid>
</Window>
