<Window x:Class="PcdConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCD Converter and Gaussian Splatting" Width="1040" Height="760" Background="White" Foreground="#1F2937"
        MinWidth="820" MinHeight="650" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
  </Window.Resources>
  <Grid Margin="22" Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="PCD Converter and Gaussian Splatting" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Convert a VISTA room map, generate Gaussian files, and launch the local viewer."
                 Foreground="#555555" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="Gaussian Splatting Repository" Margin="0,0,0,5"/>
      <DockPanel LastChildFill="True">
        <Button x:Name="RepositoryButton" Content="Select Repository..." Click="Repository_Click"
                DockPanel.Dock="Right" Margin="10,0,0,0"/>
        <TextBox x:Name="RepositoryBox" IsReadOnly="True" Padding="7"/>
      </DockPanel>
      <TextBlock Text="The last selected repository is remembered. Changing it stops the current viewer."
                 Foreground="#555555" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <WrapPanel Margin="0,0,0,10">
        <TextBlock Text="Viewer Port" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="ViewerPortBox" Text="5173" Width="90" Padding="7" MaxLength="5"
                 TextChanged="ViewerPort_Changed" LostKeyboardFocus="ViewerPort_LostFocus"
                 ToolTip="1024–65535. Stop the viewer before changing the port."/>
        <TextBlock x:Name="ViewerPortHint" Text="Remembered automatically. Stop the viewer to change its port."
                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="#555555"/>
      </WrapPanel>
      <WrapPanel>
        <Button x:Name="CheckButton" Content="Check Environment" Click="Check_Click"/>
        <Button x:Name="SetupButton" Content="Setup / Repair Environment" Click="Setup_Click"/>
        <TextBlock Text="Setup requires internet access and may take several minutes."
                   VerticalAlignment="Center" Foreground="#555555" TextWrapping="Wrap"/>
      </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock Text="Input PCD file" Margin="0,0,0,5"/>
        <TextBox x:Name="InputBox" IsReadOnly="True" Padding="7"/>
      </StackPanel>
      <Button x:Name="BrowseButton" Grid.Column="1" Content="Select PCD..." Click="Browse_Click" VerticalAlignment="Bottom"/>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Output Format" Margin="0,0,0,5"/>
        <ComboBox x:Name="FormatBox" SelectedIndex="0" Padding="7" SelectionChanged="Format_Changed">
          <ComboBoxItem Content=".txt"/>
        </ComboBox>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,0,0,12">
      <TextBlock x:Name="OutputText" Text="Output: same folder and base filename as the input PCD." TextWrapping="Wrap"/>
      <TextBlock Text="Supports ASCII PCD with X, Y, Z and intensity (0–255). The original PCD is not modified."
                 Foreground="#555555" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <WrapPanel Grid.Row="5" Margin="0,0,0,12">
      <Button x:Name="ConvertButton" Content="Convert" Click="Convert_Click"/>
      <Button x:Name="GenerateButton" Content="Convert and Generate" Click="Generate_Click"/>
      <Button x:Name="StartButton" Content="Start Viewer" Click="Start_Click"/>
      <Button x:Name="StopButton" Content="Stop Viewer" Click="Stop_Click" IsEnabled="False"/>
      <Button x:Name="OpenButton" Content="Open Viewer" Click="Open_Click" IsEnabled="False"/>
      <Button x:Name="CancelButton" Content="Cancel Task" Click="Cancel_Click" IsEnabled="False"/>
    </WrapPanel>
    <DockPanel Grid.Row="6" Margin="0,0,0,6">
      <TextBlock Text="Execution Log" FontWeight="SemiBold"/>
      <TextBlock x:Name="ViewerText" Text="Viewer: stopped" HorizontalAlignment="Right" Foreground="#555555"/>
    </DockPanel>
    <TextBox Grid.Row="7" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8" Background="#F5F6F8"/>
    <StackPanel Grid.Row="8" Margin="0,10,0,0">
      <ProgressBar x:Name="ProgressBar" Height="5" Visibility="Collapsed"/>
      <TextBlock x:Name="StatusText" Text="Ready." Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</Window>
