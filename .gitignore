# ==========================================
# Prerequisites (Compiled folders & files)
# ==========================================
*.elc
*.pyc
*.pyo

# Object files and Libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# Executables
*.exe
*.out
*.app

# ==========================================
# Output & Build Directories
# ==========================================
[Bb]uild/
[Dd]ebug/
[Rr]elease/
x64/
x86/
out/
target/

# ==========================================
# IDE and Tooling Clutter
# ==========================================
# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates

# Visual Studio Code
.vscode/
!/embedded_C/.vscode/
/embedded_C/.vscode/*
!/embedded_C/.vscode/settings.json
!/embedded_C/.vscode/extensions.json
!/embedded_C/.vscode/c_cpp_properties.json
CMakeUserPresets.json

# CLion / JetBrains
.idea/
cmake-build-*/

# ==========================================
# Local Environment & Logs
# ==========================================
*.log
.env

# Local captures and generated maps are not build inputs. Keep them on disk.
/data/raw/*.bin
/data/processed/*.pcd
/data/maps/*
!/data/maps/.gitkeep

# Runnable C++ Release packages are intentionally versioned.
# Keep exceptions scoped here: ordinary build outputs remain ignored.
!/publish/windows-x64/vista_edge.exe
/publish/windows-x64/*.dll
!/publish/linux-x86_64/vista_edge
!/publish/linux-x86_64/*.so*
!/publish/linux-arm64/vista_edge
!/publish/linux-arm64/*.so*
/publish/*/GrafanaSecret.txt
/publish/*/data/
/publish/*/*.log
/publish/*/*.pdb
/publish/*/*.ilk
/publish/*/*.obj
/publish/*/*.bin
/publish/*/*.pcd
/publish/*/*.tiles/
/publish/*/*.lock
/publish/build-info/*/*.lock
