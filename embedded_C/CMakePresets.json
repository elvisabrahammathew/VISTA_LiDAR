{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2019",
      "displayName": "Windows - Visual Studio 2019 x64",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-vs2019",
      "cacheVariables": {
        "VISTA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux - GCC",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/linux-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VISTA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2019",
      "configuration": "Debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-gcc"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2019",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
